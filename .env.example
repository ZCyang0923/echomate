# DeepSeek API（OpenAI 兼容接口；官方文档 https://api-docs.deepseek.com/zh-cn/）
# 当前官方模型包括 deepseek-flash；如官方调整名称，请以文档为准并只改这里。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# 本地向量模型。推荐中文友好的轻量多语言模型；首次使用会下载模型。
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
# auto: 优先 sentence-transformers，失败后降级为哈希向量
# sentence_transformers: 强制本地模型；hash: 强制离线哈希向量
EMBEDDING_BACKEND=auto

# 可选：向量后端 auto/chroma/sqlite。auto 在 Chroma 不可用时使用 SQLite 向量表。
VECTOR_BACKEND=auto

# 可选：数据目录、请求与上下文限制
ECHOMATE_DATA_DIR=data
# 可选：Windows 用户 TEMP 目录不可写时，Chroma 需要可写的临时目录
ECHOMATE_TEMP_DIR=data/tmp
# Hugging Face 模型缓存目录；默认放在项目 data 下
HF_HOME=data/hf_cache
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2
PROFILE_BATCH_MESSAGES=80
PROFILE_BATCH_CHARS=9000
PROFILE_MAX_BATCHES=6
PROFILE_MAX_TOKENS=1800
CHAT_MAX_TOKENS=900
CHAT_TEMPERATURE=0.8
CHAT_HISTORY_MESSAGES=12
RAG_TOP_K=5
RAG_CONTEXT_CHARS=4500
RAG_MIN_SCORE=0.08
CHUNK_SIZE_MESSAGES=8
CHUNK_OVERLAP_MESSAGES=2
MAX_UPLOAD_MB=10
